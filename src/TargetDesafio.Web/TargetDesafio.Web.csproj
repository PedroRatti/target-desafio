<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference
      Include="Microsoft.AspNetCore.OpenApi"
      Version="10.0.12"
    />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\TargetDesafio.Core\TargetDesafio.Core.csproj"
    />
  </ItemGroup>

  <ItemGroup>
    <Content
      Include="..\..\data\*.json"
      Link="data\%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>

</Project>